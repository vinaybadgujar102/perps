// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String
  password        String
  orders          Order[]
  closedPositions ClosedPosition[]
  makerFills      Fill[]           @relation("MakerFills")
  takerFills      Fill[]           @relation("TakerFills")
  payments        Payment[]
}

model Market {
  id              Int              @id @default(autoincrement())
  symbol          String           @unique
  priceScale      Int
  quantityScale   Int
  maxLeverage     Int
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orders          Order[]
  closedPositions ClosedPosition[]
  fills           Fill[]
}

model Order {
  id              Int              @id @default(autoincrement())
  orderId         String           @unique
  userId          Int
  user            User             @relation(fields: [userId], references: [id])
  marketSymbol    String
  market          Market           @relation(fields: [marketSymbol], references: [symbol])
  side            String
  orderType       String
  status          OrderStatus
  qty             Int
  filledQty       Int              @default(0)
  price           Int
  leverage        Int              @default(20)
  placedAt        DateTime
  closedPositions ClosedPosition[]
  makerFills      Fill[]           @relation("MakerFills")
  takerFills      Fill[]           @relation("TakerFills")
}

model ClosedPosition {
  id                Int      @id @default(autoincrement())
  positionId        String   @unique
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
  marketSymbol      String
  market            Market   @relation(fields: [marketSymbol], references: [symbol])
  openingOrderId    String
  openingOrder      Order    @relation(fields: [openingOrderId], references: [orderId])
  side              String
  size              Int
  averageEntryPrice Int
  realizedPnl       Int
  openedAt          DateTime
  closedAt          DateTime
}

model Fill {
  id           Int      @id @default(autoincrement())
  fillId       String   @unique
  marketSymbol String
  market       Market   @relation(fields: [marketSymbol], references: [symbol])
  makerId      Int
  maker        User     @relation("MakerFills", fields: [makerId], references: [id])
  takerId      Int
  taker        User     @relation("TakerFills", fields: [takerId], references: [id])
  makerOrderId String
  makerOrder   Order    @relation("MakerFills", fields: [makerOrderId], references: [orderId])
  takerOrderId String
  takerOrder   Order    @relation("TakerFills", fields: [takerOrderId], references: [orderId])
  price        Int
  filledQty    Int
  makerSide    String
  takerSide    String
  filledAt     DateTime
}

enum PaymentStatus {
  SUCCESS
  FAILED
  CREATED
}

model Payment {
  id        Int           @id @unique @default(autoincrement()) // the unique id for the entry
  orderId   String        @unique // the order id for which this payment is
  paymentId String? // the payment id from the razorpay which will help us to reconcile later. each order can have multiple payment tries
  status    PaymentStatus @default(CREATED) // status of the payment
  amount    Int // Razorpay minor units (USD cents); convert via scalePaymentCentsToEngine before crediting engine
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
