# perps-platform — copy to `.env` at repo root and adjust for local dev.
# Bun auto-loads `.env` when running services via turbo from the root.

# =============================================================================
# Required for core demo (api, db-poller, Prisma migrate, demo scripts)
# =============================================================================

# Postgres connection string (api, db-poller, Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# JWT signing secret for api auth — use any random string locally
JWT_SECRET=dev-secret-change-me

# API listen port — no default in code; use 3003 for the frontend proxy
PORT=3003

# =============================================================================
# Hosted demo gate (production-hosted demo — skips Timescale, trims Redis)
# =============================================================================

# Set true for hosted demo: static fake candles, low-volume sim defaults,
# 1h engine snapshots that XTRIM Redis streams after write.
# HOSTED_DEMO=true

# Snapshot interval for trade-engine (ms). Default 1 hour.
# SNAPSHOTING_INTERVAL_MS=3600000

# Frontend: disable live candle WS updates when using static fake candles
# (set in apps/tanstack-frontend/.env as well)
# VITE_HOSTED_DEMO=true

# =============================================================================
# Demo / simulator (demo:seed, simulate:orderbook)
# =============================================================================

# Login account created by demo:seed / simulate:orderbook
DEMO_USER_EMAIL=demo@perps.local
DEMO_USER_PASSWORD=demo1234

# Set to false to skip demo login user seeding
DEMO_SEED_LOGIN_USER=true

# Engine balance credited to demo user (engine monetary units; ~$500k display for BTC)
DEMO_LOGIN_BALANCE_USD=5000000000

# Redis URL — used by all services (api, engine, ws, db-poller, sim, …)
REDIS_URL=redis://localhost:6379

# Orderbook simulator tunables (scripts/simulate-orderbook.ts)
# When HOSTED_DEMO=true, defaults become: INTERVAL 9000, TRADE_PROB 0.02,
# PULL_PROB 0.01, DEPTH_LEVELS 5, ORDERS_PER_LEVEL 2, USER_COUNT 5
# SIM_INTERVAL_MS=1500
# SIM_USER_BASE=9001
# SIM_USER_COUNT=5
# SIM_DEPTH_LEVELS=10
# SIM_MID_PRICE=6100000
# SIM_SPREAD=3000
# SIM_PRICE_STEP=1000
# SIM_MIN_QTY=5
# SIM_MAX_QTY=40
# SIM_TRADE_PROB=0.35

# =============================================================================
# Optional / feature-specific
# =============================================================================

# Admin API routes (api)
# ADMIN_API_SECRET=change-me

# Razorpay onramp (api)
# RAZORPAY_TEST_API_KEY=
# RAZORPAY_TEST_SECRET_KEY=

# Funding settlement interval in ms (trade-engine; default 8h = 28800000)
# FUNDING_INTERVAL_MS=28800000

# TimescaleDB — opt-in only (USE_TIMESCALE=true + DB_URL). Default is fake candles.
# USE_TIMESCALE=true
# DB_URL=postgresql://postgres:password@127.0.0.1:5433/postgres

# =============================================================================
# Frontend (optional — defaults work locally)
# See apps/tanstack-frontend/.env.example for VITE_* overrides.
# =============================================================================

# VITE_API_PROXY_TARGET=http://localhost:3003
# VITE_WS_URL=ws://localhost:8081
# VITE_API_BASE_URL=/api/v1
